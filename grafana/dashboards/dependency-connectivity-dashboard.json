{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Connectivity status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Oracle database",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "description": "1 = reachable, 0 = down. Driven by live-traffic failures and the periodic probe.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"db-write-service\",dependency=\"database\"})",
          "legendFormat": "database",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Redis",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "description": "1 = reachable, 0 = down. Driven by live-traffic failures and the periodic probe.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"db-write-service\",dependency=\"redis\"})",
          "legendFormat": "redis",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Kafka",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "description": "1 = reachable, 0 = down. Driven by live-traffic failures and the periodic probe.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"db-write-service\",dependency=\"kafka\"})",
          "legendFormat": "kafka",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dependencies down",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "description": "How many of the 3 dependencies are currently unreachable.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(dependency_up{service=\"db-write-service\"} == 0) or vector(0)",
          "legendFormat": "down",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Availability over time",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Dependency availability",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Green = reachable, red = down. Every red band is an outage recorded by dependency_outage_count_total.",
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_up{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outage in progress",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Seconds since the dependency went down. Flat zero means everything is healthy.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_downtime_seconds{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Connectivity failures",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 9,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connectivity failures/sec by dependency and reason",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Transport-level failures only: refused, timed out, closed, pool exhausted, auth, TLS, broker unavailable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (dependency, reason) (rate(dependency_connectivity_failure_count_total{service=\"db-write-service\",dependency=~\"$dependency\"}[5m]))",
          "legendFormat": "{{dependency}} \u00b7 {{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "All dependency errors/sec (connectivity + application)",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every failure attributed to a dependency. reason=application_error means the dependency answered with an error rather than being unreachable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (dependency, reason) (rate(dependency_error_count_total{service=\"db-write-service\",dependency=~\"$dependency\"}[5m]))",
          "legendFormat": "{{dependency}} \u00b7 {{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Connectivity failures today (resets 00:00)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_connectivity_failure_daily_count{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outages started (1h window)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Up -> down transitions. A rising staircase means flapping; consider raising connectivity.failure-threshold.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "increase(dependency_outage_count_total{service=\"db-write-service\",dependency=~\"$dependency\"}[1h])",
          "legendFormat": "{{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Current state",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "description": "Live snapshot per dependency. Also available as JSON at GET /api/v1/monitoring/connectivity.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "State"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #failures"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failures today"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #downtime"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Downtime"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "dependency",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_up{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "up"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_connectivity_failure_daily_count{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "failures"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_downtime_seconds{service=\"db-write-service\",dependency=~\"$dependency\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "downtime"
        }
      ]
    },
    {
      "type": "row",
      "title": "Health probes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 15,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Probe latency (avg / max)",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Round-trip of SELECT 1 FROM DUAL (Oracle), PING (Redis), describeCluster (Kafka). Rising latency precedes most outages.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "rate(dependency_probe_latency_seconds_sum{service=\"db-write-service\",dependency=~\"$dependency\",outcome=\"success\"}[5m]) / rate(dependency_probe_latency_seconds_count{service=\"db-write-service\",dependency=~\"$dependency\",outcome=\"success\"}[5m])",
          "legendFormat": "{{dependency}} avg",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "dependency_probe_latency_seconds_max{service=\"db-write-service\",dependency=~\"$dependency\",outcome=\"success\"}",
          "legendFormat": "{{dependency}} max",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Probe failure ratio",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of probes that failed. 1 means the dependency is answering nothing at all.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
