{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Fleet overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Auth management service",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "description": "auth-service repo. 1 = every probed dependency reachable, 0 = at least one down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"auth-management-service\",dependency=~\"$dependency\"})",
          "legendFormat": "auth-management-service",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Accounting service",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "description": "aaa-account repo. 1 = every probed dependency reachable, 0 = at least one down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"accounting-service\",dependency=~\"$dependency\"})",
          "legendFormat": "accounting-service",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CDR service",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "description": "cdr-service repo. 1 = every probed dependency reachable, 0 = at least one down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"cdr-service\",dependency=~\"$dependency\"})",
          "legendFormat": "cdr-service",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DB write service",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "description": "db-write-service repo. 1 = every probed dependency reachable, 0 = at least one down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"db-write-service\",dependency=~\"$dependency\"})",
          "legendFormat": "db-write-service",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RADIUS server",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "description": "radius-server repo. 1 = every probed/live-traffic-monitored dependency reachable, 0 = at least one down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(dependency_up{service=\"radius-server\",dependency=~\"$dependency\"})",
          "legendFormat": "radius-server",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dependencies down (fleet-wide)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "description": "Count of (service, dependency) pairs currently unreachable across every selected service.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(dependency_up{service=~\"$service\",dependency=~\"$dependency\"} == 0) or vector(0)",
          "legendFormat": "down",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Connectivity status matrix",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "panels": []
    },
    {
      "type": "table",
      "title": "Current state — every service and dependency",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One row per (service, dependency) pair. Green/UP = reachable, red/DOWN = at least dependency.failure-threshold consecutive connectivity failures.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "DOWN", "color": "red", "index": 0 },
                      "1": { "text": "UP", "color": "green", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "displayName", "value": "State" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "service", "desc": false }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "service": 0, "dependency": 1, "Value": 2 }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "dependency_up{service=~\"$service\",dependency=~\"$dependency\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Dependency availability timeline",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 10,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Dependency availability by service",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Green = reachable, red = down, one row per service · dependency pair. Every red band is an outage recorded by dependency_outage_count_total.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 0, "fillOpacity": 80 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "dependency_up{service=~\"$service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{service}} · {{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Connectivity failures",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 12,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connectivity failures/sec by service, dependency and reason",
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Transport-level failures only: refused, timed out, closed, pool exhausted, auth, TLS, broker unavailable.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (service, dependency, reason) (rate(dependency_connectivity_failure_count_total{service=~\"$service\",dependency=~\"$dependency\"}[5m]))",
          "legendFormat": "{{service}} · {{dependency}} · {{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "All dependency errors/sec (connectivity + application)",
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Every failure attributed to a dependency. reason=application_error means the dependency answered with an error rather than being unreachable.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (service, dependency, reason) (rate(dependency_error_count_total{service=~\"$service\",dependency=~\"$dependency\"}[5m]))",
          "legendFormat": "{{service}} · {{dependency}} · {{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Outage activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 15,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Connectivity failures today by service (resets 00:00)",
      "id": 16,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "dependency_connectivity_failure_daily_count{service=~\"$service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{service}} · {{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outages started (1h window) by service",
      "id": 17,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Up -> down transitions. A rising staircase means flapping; consider raising connectivity.failure-threshold for that service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "increase(dependency_outage_count_total{service=~\"$service\",dependency=~\"$dependency\"}[1h])",
          "legendFormat": "{{service}} · {{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Downtime in progress",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "id": 18,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Downtime in progress by service and dependency",
      "id": 19,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Seconds since the dependency went down. Flat zero means everything is healthy.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "dependency_downtime_seconds{service=~\"$service\",dependency=~\"$dependency\"}",
          "legendFormat": "{{service}} · {{dependency}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aaa", "fleet", "connectivity", "infrastructure", "overview"],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(dependency_up, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": true },
        "hide": 0
      },
      {
        "type": "query",
        "name": "dependency",
        "label": "Dependency",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(dependency_up{service=~\"$service\"}, dependency)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": true },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "AAA Estate - Service Connectivity Overview",
  "uid": "aaa-estate-connectivity",
  "version": 1,
  "weekStart": ""
}
